@startuml
!include <C4/C4_Container>

title Marketplace — целевая диаграмма контейнеров C4

Person(buyer, "Покупатель", "Просматривает ленту, оформляет и оплачивает заказы")
Person(seller, "Продавец", "Управляет собственными товарами")

System_Ext(payment_provider, "Payment Provider", "Проводит платежи; карточные данные остаются у провайдера")
System_Ext(notification_provider, "Notification Provider", "Доставляет email, SMS или push")

System_Boundary(marketplace, "Marketplace") {
    Container(web, "Web Application", "Web", "Интерфейс пользователей маркетплейса")
    Container(gateway, "API Gateway", "HTTP reverse proxy", "Единая точка входа, маршрутизация и проверка токена")

    Container(user_service, "User Service", "Go / HTTP", "Регистрация, вход, JWT, роли и контакты")
    ContainerDb(user_db, "User DB", "PostgreSQL", "Пользователи, роли и refresh-токены")

    Container(commerce_service, "Commerce Service", "Go / HTTP", "Товары, остатки, заказы и промокоды")
    ContainerDb(commerce_db, "Commerce DB", "PostgreSQL", "Товары, заказы, позиции, промокоды и операции пользователей")

    Container(feed_service, "Feed Service", "Go / HTTP", "Персональная лента, предпочтения и ранжирование")
    ContainerDb(feed_db, "Feed DB", "PostgreSQL", "Взаимодействия, предпочтения и проекция товаров")

    Container(payment_service, "Payment Service", "Go / events", "Проведение и учёт платежей")
    ContainerDb(payment_db, "Payment DB", "PostgreSQL", "Платежи, попытки и внешние транзакции")

    Container(notification_service, "Notification Service", "Go / events", "Уведомления о статусах заказа")
    ContainerDb(notification_db, "Notification DB", "PostgreSQL", "Шаблоны, попытки и результаты доставки")

    Container(broker, "Event Broker", "RabbitMQ", "Доменные события между сервисами")
}

Rel(buyer, web, "Использует", "HTTPS")
Rel(seller, web, "Использует", "HTTPS")
Rel(web, gateway, "Вызывает API", "HTTPS/JSON")

Rel(gateway, user_service, "Регистрация, вход и обновление токена", "HTTP/JSON, sync")
Rel(gateway, commerce_service, "Товары, заказы и промокоды", "HTTP/JSON, sync")
Rel(gateway, feed_service, "Получение ленты и фиксация просмотров", "HTTP/JSON, sync")

Rel(user_service, user_db, "Читает и изменяет")
Rel(commerce_service, commerce_db, "Читает и изменяет в одной транзакции")
Rel(feed_service, feed_db, "Читает и изменяет")
Rel(payment_service, payment_db, "Читает и изменяет")
Rel(notification_service, notification_db, "Читает и изменяет")

Rel(commerce_service, broker, "Публикует ProductChanged/OrderCreated/OrderStatusChanged", "AMQP, async")
Rel(payment_service, broker, "Публикует PaymentSucceeded/PaymentFailed", "AMQP, async")
Rel(broker, feed_service, "Доставляет изменения каталога и оплаченные заказы", "AMQP, async")
Rel(broker, payment_service, "Доставляет OrderCreated", "AMQP, async")
Rel(broker, commerce_service, "Доставляет результат платежа", "AMQP, async")
Rel(broker, notification_service, "Доставляет OrderStatusChanged", "AMQP, async")

Rel(payment_service, payment_provider, "Проводит платёж", "HTTPS, sync")
Rel(notification_service, user_service, "Получает актуальный контакт", "HTTP/JSON, sync")
Rel(notification_service, notification_provider, "Отправляет сообщение", "HTTPS, sync")

SHOW_LEGEND()
@enduml
